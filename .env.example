# Generate local secrets with: node scripts/setup.mjs
POSTGRES_PASSWORD=
POSTGRES_USER=openfile
POSTGRES_DB=openfile
# Admin credentials: migration/test runner only, never passed to backend/worker.
MIGRATION_DATABASE_URL=postgres://openfile:ADMIN_PASSWORD@127.0.0.1:55432/openfile
APP_DATABASE_PASSWORD=
DATABASE_URL=postgres://openfile_app:APP_PASSWORD@127.0.0.1:55432/openfile
# Random invitation code; leave empty to disable ALL new registrations.
SIGNUP_TOKEN=
MAX_USER_BYTES=1073741824
MAX_TOTAL_BYTES=10737418240
MAX_USER_DOCUMENTS=500
MAX_USER_JOBS=50
MAX_CONVERSATIONS=100
MAX_CONVERSATION_MESSAGES=200
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
APP_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
# OAuth callback: APP_URL/api/connectors/drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Server-only absolute path, for non-Docker development:
# STORAGE_ROOT=/absolute/path/to/files
